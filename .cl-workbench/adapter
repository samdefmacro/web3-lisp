#!/usr/bin/env bash
# cl-workbench-template: adapter.template template=a4f7911dce8f rendered=edba25d59014 version=0.13.0-dev
# Thin Common Lisp Workbench adapter for web3-lisp. Application Lisp runs
# only inside the pinned project container (web3-lisp-sbcl:2.5.2-1); the warm-image lifecycle
# lives in scripts/dev.sh and cold verification in scripts/docker-test.sh. This
# adapter only routes and validates argv. Generated by `cl-workbench init`;
# regenerate a stale copy with `cl-workbench init --update`.
set -euo pipefail

: "${CL_WORKBENCH_PROJECT_ROOT:?}"
: "${CL_WORKBENCH_CONFIG:?}"
: "${CL_WORKBENCH_ROOT:?}"
: "${CL_WORKBENCH_VERSION:?}"
: "${CL_WORKBENCH_EXECUTION_PROFILE:?}"

DEV="$CL_WORKBENCH_PROJECT_ROOT/scripts/dev.sh"
DOCS_CONFIGURED=0

[ "$PWD" = "$CL_WORKBENCH_PROJECT_ROOT" ] || {
  echo "ERROR: Workbench adapter must run from the project root" >&2
  exit 2
}
[ "$CL_WORKBENCH_EXECUTION_PROFILE" = container-required ] || {
  echo "ERROR: web3-lisp requires execution.profile=container-required" >&2
  exit 2
}

run_eval() {
  [ "$#" -ge 1 ] || { echo "ERROR: repl eval requires FORM" >&2; return 2; }
  : "${CL_WORKBENCH_REPL_CLIENT:?}"
  : "${CL_WORKBENCH_REPL_HOST:?}"
  : "${CL_WORKBENCH_REPL_PORT:?}"
  : "${CL_WORKBENCH_REPL_PACKAGE:?}"
  [ "$CL_WORKBENCH_REPL_HOST" = 127.0.0.1 ] || {
    echo "ERROR: container-private REPL host must be 127.0.0.1" >&2
    return 2
  }
  [ "$CL_WORKBENCH_REPL_PORT" = "$("$DEV" identity port)" ] || {
    echo "ERROR: REPL descriptor port does not match the owned container" >&2
    return 2
  }
  DEV_SWANK_PACKAGE="$CL_WORKBENCH_REPL_PACKAGE" \
    exec "$DEV" adapter-eval "$CL_WORKBENCH_REPL_CLIENT" "$@"
}

validate_selector() {
  case "$1" in
    *[!A-Za-z0-9._:+-]*|'')
      echo "ERROR: unsafe web3-lisp test selector: $1" >&2
      return 2
      ;;
  esac
}

# The test forms live in scripts/dev.sh (`dev.sh test-form all|one SELECTOR`)
# so the warm and cold paths run the same code. Every form prints one
# `cl-workbench-checks: N` line, which the counted gate below reads.
run_test() {
  : "${CL_WORKBENCH_REPL_CLIENT:?}"
  local form
  case "$#" in
    0)
      form="$("$DEV" test-form all)" || return 2
      # A chatty runner prints one line per test; the default 10k eval cap
      # would cut off the trailing cl-workbench-checks line.
      DEV_EVAL_TIMEOUT="${DEV_EVAL_TIMEOUT:-3600}" \
        DEV_EVAL_MAX_OUTPUT="${DEV_EVAL_MAX_OUTPUT:-2000000}" \
        exec "$DEV" adapter-eval "$CL_WORKBENCH_REPL_CLIENT" "$form"
      ;;
    1)
      validate_selector "$1" || return 2
      form="$("$DEV" test-form one "$1")" || return 2
      DEV_EVAL_TIMEOUT="${DEV_EVAL_TIMEOUT:-600}" \
        DEV_EVAL_MAX_OUTPUT="${DEV_EVAL_MAX_OUTPUT:-2000000}" \
        exec "$DEV" adapter-eval "$CL_WORKBENCH_REPL_CLIENT" "$form"
      ;;
    *)
      echo "ERROR: web3-lisp accepts at most one test selector" >&2
      return 2
      ;;
  esac
}

# Run a validation gate command, mirror its output, and report the check
# counter through the Workbench one-shot result file. A green run that
# counted zero checks is refused: a zero-selection pass is not a pass.
run_counted_gate() { # $@ = gate command
  local tmp rc=0 count=""
  tmp="$(mktemp -t web3-lisp-gate)"
  "$@" 2>&1 | tee "$tmp" || rc=$?
  count="$(grep -Eo 'cl-workbench-checks: [0-9]+' "$tmp" | tail -1 | grep -Eo '[0-9]+' || true)"
  rm -f "$tmp"
  if [ "$rc" -eq 0 ] && { [ -z "$count" ] || [ "$count" -eq 0 ]; }; then
    echo "ERROR: gate reported success but no checks were counted" >&2
    return 1
  fi
  if [ -n "${CL_WORKBENCH_VALIDATION_RESULT:-}" ] && [ -n "$count" ]; then
    printf '{"schema_version":1,"check_count":%s,"retry_count":0}\n' "$count" \
      > "$CL_WORKBENCH_VALIDATION_RESULT"
  fi
  return "$rc"
}

run_validation() {
  [ "$#" -ge 1 ] || { echo "ERROR: validation run requires PROFILE" >&2; return 2; }
  local profile="$1"
  shift
  case "$profile" in
    warm-unit)
      [ "$#" -eq 1 ] || {
        echo "ERROR: warm-unit requires exactly one test selector" >&2
        return 2
      }
      validate_selector "$1" || return 2
      run_counted_gate "$DEV" test "$1"
      ;;
    cold-unit)
      [ "$#" -eq 0 ] || {
        echo "ERROR: cold-unit accepts no arguments" >&2
        return 2
      }
      run_counted_gate "$CL_WORKBENCH_PROJECT_ROOT/scripts/docker-test.sh"
      ;;
    cold-docs)
      [ "$#" -eq 0 ] || {
        echo "ERROR: cold-docs accepts no arguments" >&2
        return 2
      }
      [ "$DOCS_CONFIGURED" -eq 1 ] || {
        echo "ERROR: docs verification is not configured for web3-lisp" >&2
        return 2
      }
      exec "$DEV" docs-check
      ;;
    *)
      echo "ERROR: unknown web3-lisp validation profile: $profile" >&2
      return 2
      ;;
  esac
}

case "${1:-}" in
  doctor)
    [ "$#" -eq 1 ] || exit 2
    [ -x "$DEV" ] || { echo "ERROR: scripts/dev.sh is not executable" >&2; exit 1; }
    [ -f "$CL_WORKBENCH_ROOT/tools/repl/agent-eval.lisp" ] || {
      echo "ERROR: canonical Workbench eval client is unavailable" >&2
      exit 1
    }
    exec "$DEV" doctor
    ;;
  repl)
    [ "$#" -ge 2 ] || exit 2
    action="$2"
    shift 2
    case "$action" in
      start)
        [ "$#" -eq 0 ] || exit 2
        exec "$DEV" start    # dev.sh writes the REPL descriptor itself
        ;;
      stop)
        [ "$#" -eq 0 ] || exit 2
        exec "$DEV" stop     # and removes it
        ;;
      status)
        [ "$#" -eq 0 ] || exit 2
        exec "$DEV" status
        ;;
      eval) run_eval "$@" ;;
      *) echo "ERROR: unknown REPL adapter operation: $action" >&2; exit 2 ;;
    esac
    ;;
  test)
    shift
    run_test "$@"
    ;;
  docs)
    [ "$#" -eq 2 ] && [ "$2" = verify ] || exit 2
    [ "$DOCS_CONFIGURED" -eq 1 ] || {
      echo "ERROR: docs verification is not configured for web3-lisp" >&2
      exit 2
    }
    exec "$DEV" docs-check
    ;;
  validation)
    [ "$#" -ge 2 ] && [ "$2" = run ] || exit 2
    shift 2
    run_validation "$@"
    ;;
  *)
    echo "ERROR: unsupported Workbench adapter operation: ${1:-<missing>}" >&2
    exit 2
    ;;
esac
