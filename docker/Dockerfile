# Containerized toolchain for web3-lisp: Debian's SBCL plus a Quicklisp with
# the project's dependencies pre-loaded. Generated by `cl-workbench init` as a
# STARTING POINT — this file is project-owned: edit it freely (pin a specific
# SBCL, add foreign libraries, ...); `init --update` never touches it.
#
# The image is TOOLCHAIN ONLY — the repository is bind-mounted at /workspace at
# run time (scripts/docker-sbcl.sh, scripts/dev.sh), so rebuilds are needed only
# when the toolchain changes, never for code changes. CL_SOURCE_REGISTRY scans
# /workspace recursively, so vendored checkouts under the repo (for example a
# pinned refs/<library>) win over the Quicklisp copy at run time.
#
# TAG CONVENTION: <sbcl-version>-<toolchain-revision>. Bump the suffix whenever
# anything in the image changes instead of rebuilding a tag in place: the Docker
# daemon is shared with other sessions, and they keep working against the tag
# they started with until they choose to rebuild. Current tag: web3-lisp-sbcl:2.5.2-1
#
# Build (from the repo root):
#   docker build -f docker/Dockerfile -t web3-lisp-sbcl:2.5.2-1 .

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    sbcl git make gcc libc6-dev zlib1g-dev libssl3t64 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# refs/ holds READING references (a newer Coalton master among them). The code is
# written against the Coalton shipped in the Quicklisp 2025-06-22 dist, so the
# registry scans the repo but excludes refs/, and the dist below is pinned.
ENV CL_SOURCE_REGISTRY='(:source-registry (:exclude "refs") (:tree "/workspace/") :ignore-inherited-configuration)' \
    XDG_CACHE_HOME=/fasl-cache

# Quicklisp at /opt/quicklisp with the dependencies pre-loaded so the first
# container start compiles only the project itself.
RUN curl -fsSL https://beta.quicklisp.org/quicklisp.lisp -o /tmp/quicklisp.lisp \
 && sbcl --non-interactive --load /tmp/quicklisp.lisp \
      --eval '(quicklisp-quickstart:install :path "/opt/quicklisp/" :dist-url "http://beta.quicklisp.org/dist/quicklisp/2025-06-22/distinfo.txt")' \
 && printf '%s\n' '(load "/opt/quicklisp/setup.lisp")' > /root/.sbclrc \
 && sbcl --dynamic-space-size 4096 --non-interactive \
      --eval '(ql:quickload (list "ironclad" "cffi" "bordeaux-threads" "cl-base64" "cl-json" "dexador" "named-readtables" "split-sequence" "websocket-driver-client" "coalton"))' \
 && rm /tmp/quicklisp.lisp

WORKDIR /workspace
CMD ["sbcl"]
